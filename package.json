{
  "name": "dsh-llm-omni",
  "version": "0.1.0",
  "description": "DSH provider 插件：把本地 OmniAPI（Web-to-API 代理）注册为 LLM 路由",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "omni",
    "openai-compatible"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node scripts/e2e-live.mjs"
  }
}
