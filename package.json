{
  "name": "dsh-llm-omni",
  "version": "0.1.0",
  "description": "DSH provider 插件：把 DeepSeek Web 转发能力内嵌进 DeepSeek Harness，装完填账号即可用",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "omni",
    "openai-compatible"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "kernel",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "test"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "undici": "^6.27.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<你的用户名>/dsh-llm-omni.git"
  },
  "bugs": {
    "url": "https://github.com/<你的用户名>/dsh-llm-omni/issues"
  },
  "homepage": "https://github.com/<你的用户名>/dsh-llm-omni#readme"
}
